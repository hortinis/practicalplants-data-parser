{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/practicalplants/page.schema.json",
  "type": "object",
  "required": [
    "identity",
    "source",
    "references",
    "links",
    "categories"
  ],
  "properties": {
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "reference.schema.json"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/categoryMembership"
      }
    },
    "plant": {
      "$ref": "plant.schema.json"
    },
    "taxonomy": {
      "type": "object"
    },
    "fullData": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldValue"
          }
        }
      }
    },
    "narrative": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/narrative"
      }
    },
    "uses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/use"
      }
    },
    "useNotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/useNote"
      }
    },
    "toxicity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toxicity"
      }
    },
    "concept": {
      "$ref": "concept.schema.json"
    },
    "index": {
      "type": "object"
    },
    "alias": {
      "$ref": "#/$defs/alias"
    },
    "collection": {
      "$ref": "#/$defs/collection"
    },
    "polyculture": {
      "$ref": "#/$defs/polyculture"
    },
    "interaction": {
      "$ref": "#/$defs/interaction"
    },
    "documentation": {
      "$ref": "#/$defs/documentation"
    },
    "unknown": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "identity": { "properties": { "pageType": { "const": "documentation" } } } } },
      "then": { "required": ["documentation"] }
    },
    {
      "if": { "properties": { "identity": { "properties": { "pageType": { "const": "alias" } } } } },
      "then": { "required": ["alias"] }
    },
    {
      "if": { "properties": { "identity": { "properties": { "pageType": { "const": "collection" } } } } },
      "then": { "required": ["collection"] }
    },
    {
      "if": { "properties": { "identity": { "properties": { "pageType": { "const": "polyculture" } } } } },
      "then": { "required": ["polyculture"] }
    },
    {
      "if": { "properties": { "identity": { "properties": { "pageType": { "const": "interaction" } } } } },
      "then": { "required": ["interaction"] }
    },
    {
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "pageType": {
                "const": "plant"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "plant",
          "taxonomy",
          "fullData",
          "narrative",
          "uses",
          "useNotes",
          "toxicity"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "pageType": {
                "const": "concept"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "concept"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "pageType": {
                "const": "index"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "index"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "pageType": {
                "const": "unknown"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "unknown"
        ]
      }
    }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "pageId",
        "title",
        "pageType",
        "sourcePath"
      ],
      "properties": {
        "pageId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "pageType": {
          "enum": [
            "plant",
            "alias",
            "collection",
            "polyculture",
            "interaction",
            "documentation",
            "concept",
            "index",
            "unknown"
          ]
        },
        "sourcePath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "href",
        "label",
        "linkType"
      ],
      "properties": {
        "href": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "targetPageId": {
          "type": "string"
        },
        "linkType": {
          "enum": [
            "internal",
            "external",
            "unknown"
          ]
        },
        "resolved": {
          "type": "boolean"
        },
        "redLink": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "categoryMembership": {
      "type": "object",
      "required": ["categoryPageId", "name", "hidden", "link", "sourceLocation"],
      "properties": {
        "categoryPageId": { "type": "string", "pattern": "^Category:" },
        "name": { "type": "string" },
        "hidden": { "type": "boolean" },
        "link": { "$ref": "#/$defs/link" },
        "sourceLocation": { "$ref": "#/$defs/sourceLocation" }
      },
      "additionalProperties": false
    },
    "fieldValue": {
      "type": "object",
      "required": [
        "rawValue",
        "status",
        "links"
      ],
      "properties": {
        "rawValue": {
          "type": "string"
        },
        "normalizedValue": {},
        "status": {
          "enum": [
            "known",
            "unknown",
            "none_listed",
            "empty"
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "sourceLocation": {
          "$ref": "#/$defs/sourceLocation"
        }
      },
      "additionalProperties": false
    },
    "sourceLocation": {
      "type": "object",
      "required": [
        "page"
      ],
      "properties": {
        "page": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "field": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "narrative": {
      "type": "object",
      "required": [
        "id",
        "title",
        "paragraphs",
        "lists",
        "links",
        "references",
        "sourceLocation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lists": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceLocation": {
          "$ref": "#/$defs/sourceLocation"
        }
      },
      "additionalProperties": false
    },
    "use": {
      "type": "object",
      "required": [
        "category",
        "references"
      ],
      "properties": {
        "category": {
          "enum": [
            "edible",
            "material",
            "medicinal"
          ]
        },
        "plantPart": {
          "type": "string"
        },
        "use": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceLocation": {
          "$ref": "#/$defs/sourceLocation"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      },
      "additionalProperties": false
    },
    "useNote": {
      "type": "object",
      "required": [
        "category",
        "text",
        "links",
        "references",
        "sourceLocation"
      ],
      "properties": {
        "category": {
          "enum": [
            "edible",
            "material",
            "medicinal"
          ]
        },
        "text": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceLocation": {
          "$ref": "#/$defs/sourceLocation"
        }
      },
      "additionalProperties": false
    },
    "toxicity": {
      "type": "object",
      "required": [
        "plantParts",
        "references"
      ],
      "properties": {
        "plantParts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compound": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceLocation": {
          "$ref": "#/$defs/sourceLocation"
        }
      },
      "additionalProperties": false
    },
    "alias": {
      "type": "object",
      "required": ["targets"],
      "properties": {
        "kind": { "enum": ["common_name", "synonym", "redirect", "unknown"] },
        "description": { "type": "string" },
        "targets": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "required": ["kind", "members", "completeness", "memberSource"],
      "properties": {
        "kind": { "enum": ["family", "genus", "use", "category", "catalog", "unknown"] },
        "description": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "completeness": { "enum": ["populated", "empty"] },
        "memberSource": { "enum": ["archive_page", "plant_uses_inverse", "category_membership_inverse"] },
        "subcategories": { "type": "array", "items": { "type": "string", "pattern": "^Category:" } },
        "totalMembers": { "type": "integer", "minimum": 0 },
        "membersComplete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "polycultureMemberField": {
      "type": "object",
      "required": ["text", "links"],
      "properties": {
        "text": { "type": "string" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      },
      "additionalProperties": false
    },
    "polycultureMember": {
      "type": "object",
      "required": ["plant", "ecosystemNiches", "functions", "uses", "sourceLocation"],
      "properties": {
        "plant": {
          "type": "object",
          "required": ["name", "commonNames", "links"],
          "properties": {
            "name": { "type": "string" },
            "pageId": { "type": "string" },
            "commonNames": { "type": "array", "items": { "type": "string" } },
            "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
          },
          "additionalProperties": false
        },
        "ecosystemNiches": { "$ref": "#/$defs/polycultureMemberField" },
        "functions": { "$ref": "#/$defs/polycultureMemberField" },
        "uses": { "$ref": "#/$defs/polycultureMemberField" },
        "sourceLocation": { "$ref": "#/$defs/sourceLocation" }
      },
      "additionalProperties": false
    },
    "polyculture": {
      "type": "object",
      "required": ["members", "narrative"],
      "properties": {
        "description": { "type": "string" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/polycultureMember" } },
        "narrative": { "type": "array", "items": { "$ref": "#/$defs/narrative" } }
      },
      "additionalProperties": false
    },
    "interactionField": {
      "type": "object",
      "required": ["text", "links", "references", "sourceLocation"],
      "properties": {
        "text": { "type": "string" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "references": { "type": "array", "items": { "type": "string" } },
        "sourceLocation": { "$ref": "#/$defs/sourceLocation" }
      },
      "additionalProperties": false
    },
    "interactionMember": {
      "type": "object",
      "required": ["name", "links", "sourceLocation"],
      "properties": {
        "name": { "type": "string" },
        "pageId": { "type": "string" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "sourceLocation": { "$ref": "#/$defs/sourceLocation" }
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "required": ["leftMember", "rightMember", "direction", "effect", "impact", "details"],
      "properties": {
        "description": { "type": "string" },
        "leftMember": { "$ref": "#/$defs/interactionMember" },
        "rightMember": { "$ref": "#/$defs/interactionMember" },
        "direction": { "$ref": "#/$defs/interactionField" },
        "effect": { "$ref": "#/$defs/interactionField" },
        "impact": { "$ref": "#/$defs/interactionField" },
        "details": { "$ref": "#/$defs/interactionField" }
      },
      "additionalProperties": false
    },
    "documentation": {
      "type": "object",
      "required": ["headings"],
      "properties": {
        "namespace": { "type": "string" },
        "headings": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
